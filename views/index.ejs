<!DOCTYPE html>
<html lang="en">
<head>
    <title> <%= title %> </title>
      <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <a href="/new">New Form</a>
    <h1>
        Hello World
    </h1>
    <ul>


        <% messages.map((message)=>{ %>
            <li>
                <div>
                    <h2> <%= message.user %> </h2>
                    <h1> <%= message.text %> </h1>
                </div>
                <% const path = `/details/${message.user}` %>
                <a href=<%=path %> >Message Details</a>
            </li>
            <% }) %>
    </ul>
</body>
</html>