<!DOCTYPE html>
<html lang="en">
<head>
    <title> <%= title %> </title>
      <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <h1>
        Hello World
    </h1>
    <ul>


        <% messages.map((message)=>{ %>
            <li>
                    <h4> <%= message.added %> </h4>
                <div>
                    <h2> <%= message.user %> </h2>
                    <h1> <%= message.text %> </h1>

                </div>
            </li>
            <% }) %>
    </ul>
</body>
</html>